{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlphaSpecification",
  "type": "object",
  "properties": {
    "strategy_name": {"type": "string"},
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "params": {"type": "object"}
        },
        "required": ["name", "params"]
      }
    },
    "entry_long_conditions": {"type": "array", "items": {"type": "string"}},
    "entry_short_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["strategy_name", "indicators", "entry_long_conditions", "entry_short_conditions"]
}
