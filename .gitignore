# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Pytest / testing
.pytest_cache/
.coverage
htmlcov/

# Jesse Framework specific exclusions
jesse_workspace/storage/
jesse_workspace/storage_jesse/

# Environment variables & secrets (CRITICAL: Do not upload API keys!)
jesse_workspace/.env
.env

# SQLite databases if generated locally
*.db
*.sqlite
*.sqlite3

# Windows OS files
Thumbs.db
Desktop.ini

# Virtual Environment
venv/
.venv/
.venv-jesse/

# Market data: large, and re-fetchable from the exchange. The .meta.json files
# ARE tracked — they carry the sha256 and window that make a result reproducible.
research/data/*.npy
research/data/*.json
!research/data/*.meta.json

# Portable Git utility
bin/MinGit/

# Personal Access Tokens / keys
*PAT*
Personal

# Graphify knowledge graph (rigenerabile: /graphify)
graphify-out/

# Local tooling config
.claude/
